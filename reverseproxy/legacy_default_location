# Archived production rule from the previous nginx-proxy configuration.
# This sends camera requests straight to the edge without the backend's current
# approved-account stream-cookie check. Keep disabled unless equivalent auth is
# added before restoring it.
location ~^/(parking|parking2|license|license1|infer-live)/ {
        proxy_pass https://10.41.11.21:8888;
        proxy_ssl_verify       off;
        proxy_ssl_name         10.41.11.21;
        proxy_http_version     1.1;
        proxy_set_header       Host $host;
        proxy_set_header       X-Real-IP $remote_addr;
        proxy_set_header       X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header       X-Forwarded-Proto $scheme;

        add_header Access-Control-Allow-Origin *;
        add_header Access-Control-Allow-Credentials true;
}
