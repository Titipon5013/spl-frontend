# Route each HLS request through the backend's approved-account cookie check.
location ~ ^/(parking|parking2|license|license1)(/|$) {
    proxy_pass http://backend:8000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Cookie $http_cookie;
    proxy_buffering off;
    proxy_cache off;
    proxy_no_cache 1;
    proxy_hide_header Cache-Control;
    add_header Cache-Control "private, no-store" always;
}

# Keep the former direct-to-edge route archived in this image. Do not enable it
# until it has equivalent account and stream-cookie checks.
location ~ ^/infer-live(/|$) {
    add_header Cache-Control "private, no-store" always;
    return 404;
}
